{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "web",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests,reports,outputs,datos,vendor,.venv-dev,.codex-work,api/data}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" }
  ]
}
